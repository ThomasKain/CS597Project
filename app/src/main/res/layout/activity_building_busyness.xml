<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="start"
    android:layout_marginStart="10dp"
    android:layout_marginTop="10dp"
    android:layout_marginEnd="15dp"
    tools:context=".BuildingBusyness">

    <Button
        android:id="@+id/button_back_busyness"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/back"
        android:backgroundTint="#636363"
        />
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginVertical="8dp"
        android:background="#bababa" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/select_a_building_to_view_current_availability"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="18dp"
        android:textSize="18sp" />

    <!-- ===== Gateway North ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/button_gnorth_busyness"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Gafteway North"
            android:textSize="18sp"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Busyness meter: the colored part grows with the % of taken seats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:orientation="horizontal"
                android:background="#CCCCCC">

                <View
                    android:id="@+id/bar_fill_gnorth"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="25"
                    android:background="#C0392B" />

                <View
                    android:id="@+id/bar_empty_gnorth"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="75" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_gnorth_busyness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="25% full"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Gateway South ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/button_gsouth_busyness"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Gateway South"
            android:textSize="18sp"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:orientation="horizontal"
                android:background="#CCCCCC">

                <View
                    android:id="@+id/bar_fill_gsouth"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="25"
                    android:background="#C0392B" />

                <View
                    android:id="@+id/bar_empty_gsouth"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="75" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_gsouth_busyness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="25% full"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>