<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".SeatMapActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <edu.stevens.cs597.seatfinder.SeatMapView
            style="@style/Widget.Theme.SeatFinder.MyView"
            android:id="@+id/floor_1_seat_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <edu.stevens.cs597.seatfinder.SeatMapView
            style="@style/Widget.Theme.SeatFinder.MyView"
            android:id="@+id/floor_2_seat_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/floor1_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Floor 1" />

        <Button
            android:id="@+id/floor2_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Floor 2" />
    </LinearLayout>
</LinearLayout>